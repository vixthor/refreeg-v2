model Country {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  latitude  Float?
  longitude Float?

  states    State[]

  @@map("countries")
}

model State {
  id           BigInt   @id @default(autoincrement())
  name         String
  countryId    BigInt
  country      Country  @relation(fields: [countryId], references: [id])

  cities       City[]

  @@map("state")
}

model City {
  id         BigInt   @id @default(autoincrement())
  name       String
  stateId    BigInt
  state      State    @relation(fields: [stateId], references: [id])

  latitude   Float?
  longitude  Float?

  @@map("cities")
}