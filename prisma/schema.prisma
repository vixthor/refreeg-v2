generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                 String?
  accountNumber         String?   @map("account_number")
  bankName              String?   @map("bank_name")
  accountName           String?   @map("account_name")
  profilePhoto          String?   @map("profile_photo")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  isBlocked             Boolean?  @map("is_blocked")
  subAccountCode        String?   @map("sub_account_code")
  bio                   String?
  solana_wallet         String?
  twitter_url           String?
  facebook_url          String?
  instagram_url         String?
  linkedin_url          String?
  accountType           String?   @map("account_type")
  isVerified            Boolean?  @default(false) @map("is_verified")
  gender                String?
  website               String?
  referralCode          String?   @unique @map("referral_code")
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  username              String?   @unique
  location              String?
  email                 String?   @unique
  onboarding_completed  Boolean?  @default(false)
  fullName              String?   @map("full_name")
  total_points          Int?      @default(0)
  current_tier          String?   @default("Tier 1")
  Total_Engagements     Int?      @map("Total Engagements")
  eiza_balance          Decimal?  @db.Decimal
  total_eiza_earned     Decimal?  @db.Decimal
  upvotes_received      Int?
  content_quality_score Decimal?  @db.Decimal
  spam_flags            Int?      @db.SmallInt
  login_streak          Int?      @db.SmallInt
  last_login_date       DateTime? @db.Date
  weekly_streak_count   Int?      @default(0) @db.SmallInt
  monthly_streak_count  Int?      @default(0) @db.SmallInt
  emailVerified         DateTime? @map("email_verified")
  password              String?
  lastLoginUserAgent    String?   @map("last_login_user_agent")
  accounts              Account[]
  sessions              Session[]

  @@index([isBlocked], map: "idx_profiles_is_blocked")
  @@map("profiles")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@map("password_reset_tokens")
}

model Cause {
  id              String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  title           String
  description     String?
  category        String
  goal            Decimal   @db.Decimal
  raised          Decimal?  @default(0) @db.Decimal
  status          String?   @default("pending")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  image           String?
  shared          Decimal?  @default(0) @db.Decimal
  daysActive      Int?      @map("days_active")
  videoLinks      String[]  @default([]) @map("video_links")
  multimedia      Json?
  trust_score     Json?     @default("{\"impact\": \"B+\", \"readability\": \"A\", \"transparency\": \"High\"}")
  verified_status String?   @default("pending")
  summary         String?
  location        String?
  faqs            Json?     @default("[]")
  start_date      DateTime? @db.Timestamptz(6)
  end_date        DateTime? @db.Timestamptz(6)

  @@index([daysActive], map: "idx_causes_days_active")
  @@index([status], map: "idx_causes_status")
  @@index([userId], map: "idx_causes_user_id")
  @@index([videoLinks], map: "idx_causes_video_links", type: Gin)
  @@map("causes")
}

model Donation {
  id           String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  causeId      String    @map("cause_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  amount       Decimal   @db.Decimal
  name         String?
  email        String
  message      String?
  is_anonymous Boolean?  @default(false)
  status       String?   @default("completed")
  receipt_url  String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tip_amount   Decimal?  @default(0) @db.Decimal

  @@index([causeId], map: "idx_donations_cause_id")
  @@index([userId], map: "idx_donations_user_id")
  @@map("donations")
}

model Referral {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId   String    @map("referrer_id") @db.Uuid
  refereeId    String?   @map("referee_id") @db.Uuid
  refereeEmail String    @map("referee_email")
  registered   Boolean?  @default(false)
  reward       String?
  createdAt    DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@unique([referrerId, refereeEmail], map: "unique_referral_email_per_referrer")
  @@map("referrals")
}

model Role {
  id         String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  role       String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_roles_user_id")
  @@map("roles")
}

model UserWallet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  balance   Decimal?  @default(0) @db.Decimal
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_user_wallets_user_id")
  @@map("user_wallets")
}

model UserStreak {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  weeklyStreak    Int?      @default(0) @map("weekly_streak")
  isMonthlyActive Boolean?  @default(false) @map("is_monthly_active")
  lastActiveDate  DateTime? @map("last_active_date") @db.Timestamptz(6)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_user_streaks_user_id")
  @@map("user_streaks")
}

model RewardTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  amount          Decimal   @db.Decimal
  transactionType String    @map("transaction_type")
  event_id        String?   @db.Uuid
  status          String?   @default("completed")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_reward_transactions_created_at")
  @@index([userId], map: "idx_reward_transactions_user_id")
  @@map("reward_transactions")
}

